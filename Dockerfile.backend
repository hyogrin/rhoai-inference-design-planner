FROM python:3.11-slim AS builder

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock* README.md ./
RUN uv sync --frozen --no-dev

COPY domain/ domain/
COPY backend/ backend/
COPY agents/ agents/
COPY connectors/ connectors/
COPY estimators/ estimators/
COPY mcp_servers/ mcp_servers/
COPY templates/ templates/
COPY migrations/ migrations/
COPY alembic.ini .

FROM python:3.11-slim

WORKDIR /app

COPY --from=builder /app /app

ENV PATH="/app/.venv/bin:$PATH"
ENV HF_HOME="/tmp/hf_cache"
# Fix Playwright browser path for OpenShift (runs as arbitrary non-root UID)
ENV PLAYWRIGHT_BROWSERS_PATH=/app/.playwright-browsers

# Install Playwright Chromium + OS dependencies for headless browser
RUN apt-get update && apt-get install -y --no-install-recommends \
        libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
        libxcomposite1 libxdamage1 libxrandr2 libgbm1 libpango-1.0-0 \
        libcairo2 libasound2 libxshmfence1 libxkbcommon0 fonts-liberation \
    && playwright install chromium \
    && chmod -R o+rx /app/.playwright-browsers \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

EXPOSE 8000

CMD ["uvicorn", "backend.api:app", "--host", "0.0.0.0", "--port", "8000"]

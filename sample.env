# Inference Design Planner - Environment Configuration
# Copy to .env and fill in your values.

# LLM Configuration (OpenAI-compatible — RHOAI MaaS, vLLM, or OpenAI)
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o

# Hugging Face (optional, for gated model access)
HF_TOKEN=

# PostgreSQL (sessions + LangGraph checkpointing)
DATABASE_URL=postgresql+asyncpg://planner:planner@localhost:5432/inference_planner
DATABASE_URL_SYNC=postgresql://planner:planner@localhost:5432/inference_planner

# SSL (set to false for self-signed certs)
VERIFY_SSL=true

# Observability — MLflow
# When empty, auto-inferred from OPENAI_BASE_URL for RHOAI clusters:
#   OPENAI_BASE_URL=https://maas.apps.<cluster>/<ws>/<model>/v1
#   → MLFLOW_TRACKING_URI=https://rh-ai.apps.<cluster>/mlflow, MLFLOW_WORKSPACE=<ws>
# Auth: token (cluster SA) > MLFLOW_TRACKING_AUTH > kubernetes-namespaced (oc login)
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_TOKEN=
MLFLOW_TRACKING_INSECURE_TLS=false
MLFLOW_EXPERIMENT_NAME=inference-design-planner
MLFLOW_WORKSPACE=
PROMETHEUS_ENABLED=true

# Golden dataset generation
# Default: uses OPENAI_BASE_URL/OPENAI_API_KEY with a different model name
# Optional: set ANTHROPIC_API_KEY and pass --backend anthropic
GOLDEN_MODEL_NAME=claude-opus-4-6-20250826
ANTHROPIC_API_KEY=

# Application
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:7000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:7001
NEXT_PUBLIC_AGENT_URL=http://localhost:7001/agent
